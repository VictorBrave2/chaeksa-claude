#!/bin/sh
# 커밋 메시지에 「정한 것:」 줄이 없으면 커밋을 거부한다.
#
# 왜: 2026-09-09 사장님 「우리 이렇게 하기로 하자 해놓고 니가 마음대로 바꾸면
#     내가 알아채기도 힘들 뿐더러 예상치를 훨씬 벗어나잖아」
#     문제는 내가 임의로 정한 것을 결과 안에 섞어서 말한 것이었다.
#     메모리는 내가 읽어야 작동하지만 이 훅은 내가 안 읽어도 작동한다.
#
# 끄려면: git config --unset core.hooksPath

if ! grep -q '^정한 것:' "$1"; then
  echo "" >&2
  echo "  커밋 거부 — 메시지에 「정한 것:」 줄이 없습니다." >&2
  echo "" >&2
  echo "  사장님이 안 시켰는데 내가 정한 것을 그 줄에 적는다." >&2
  echo "  이름·상수·축·범위·순서를 내가 골랐으면 전부 여기 적는다." >&2
  echo "  정말 없으면 「정한 것: 없음」." >&2
  echo "" >&2
  exit 1
fi
exit 0
